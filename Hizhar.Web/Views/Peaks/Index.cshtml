@model AllPeaksQueryModel
@{
    ViewData["Title"] = "Върхове";
    bool isSignedIn = User.Identity?.IsAuthenticated == true;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="hz-page-header">
    <h1>Върхове</h1>
    <p class="subtitle">Отбелязвай изкачените върхове и следи прогреса си в профила.</p>
</div>

<form method="get" asp-action="Index" class="hz-filters mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="SearchTerm" class="form-label"></label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Име на връх..." />
        </div>
        <div class="col-md-3">
            <label asp-for="MountainId" class="form-label"></label>
            <select asp-for="MountainId" class="form-select"
                    asp-items="@(new SelectList(Model.Mountains, nameof(MountainOptionViewModel.Id), nameof(MountainOptionViewModel.Name)))">
                <option value="">Всички планини</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="MinElevation" class="form-label"></label>
            <input asp-for="MinElevation" class="form-control" type="number" min="0" max="3000" step="100" placeholder="2500" />
        </div>
        <div class="col-md-2">
            <div class="form-check mb-2">
                <input asp-for="OnlyNational" class="form-check-input" />
                <label asp-for="OnlyNational" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-hz"><i class="bi bi-search"></i> Търси</button>
        </div>
    </div>
</form>

<div class="hz-panel p-0">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Връх</th>
                <th>Планина</th>
                <th>Височина</th>
                <th class="d-none d-md-table-cell">Изкачили го</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Peaks.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Няма намерени върхове.</td></tr>
            }
            @foreach (PeakListItemViewModel peak in Model.Peaks)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@peak.Id" class="fw-semibold">@peak.Name</a>
                        @if (peak.IsNationalTouristSite)
                        {
                            <span class="badge bg-warning text-dark ms-1" title="От 100-те национални туристически обекта">НТО</span>
                        }
                    </td>
                    <td>@peak.MountainName</td>
                    <td>@peak.Elevation м</td>
                    <td class="d-none d-md-table-cell">@peak.ClimbersCount</td>
                    <td class="text-end">
                        @if (isSignedIn)
                        {
                            <form method="post" asp-controller="ClimbedPeaks" asp-action="Toggle"
                                  asp-route-peakId="@peak.Id" asp-route-returnUrl="@returnUrl" class="d-inline">
                                @if (peak.IsClimbed)
                                {
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-circle"></i> Изкачен</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-hz"><i class="bi bi-flag"></i> Изкачих го</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>