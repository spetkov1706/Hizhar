@model ReviewFormModel

<form method="post" asp-controller="Reviews" asp-action="Create" class="bg-light rounded-3 p-3 mb-3">
    <input type="hidden" asp-for="HutId" />
    <div class="row g-2">
        <div class="col-md-3">
            <label asp-for="Rating" class="form-label"></label>
            <select asp-for="Rating" class="form-select">
                <option value="5">★★★★★ (5)</option>
                <option value="4">★★★★ (4)</option>
                <option value="3">★★★ (3)</option>
                <option value="2">★★ (2)</option>
                <option value="1">★ (1)</option>
            </select>
            <span asp-validation-for="Rating" class="field-validation-error"></span>
        </div>
        <div class="col-md-9">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="2" placeholder="Как беше престоят ви?"></textarea>
            <span asp-validation-for="Content"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-hz btn-sm mt-2"><i class="bi bi-send"></i> Публикувай ревю</button>
</form>