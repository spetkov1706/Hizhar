@{
    ViewData["Title"] = "Карта";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="hz-page-header">
    <h1>Карта</h1>
    <div class="hz-map-legend small">
        <span><i class="bi bi-house-fill" style="color:#1f4d3a"></i> Хижа</span>
        <span><i class="bi bi-triangle-fill" style="color:#e07a32"></i> Връх</span>
        <span><span class="line" style="background:#2e9d5b"></span> Лесен</span>
        <span><span class="line" style="background:#e0a526"></span> Среден</span>
        <span><span class="line" style="background:#c8432f"></span> Труден маршрут</span>
    </div>
</div>

<div id="hz-map"></div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}