@model IEnumerable<MountainIndexViewModel>
@{
    ViewData["Title"] = "Планини";
}

<div class="hz-page-header">
    <h1>Планини</h1>
    <p class="subtitle">Избери планина, за да видиш хижите, върховете и маршрутите в нея.</p>
</div>

<div class="row g-4">
    @foreach (MountainIndexViewModel mountain in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card hz-card">
                @if (!string.IsNullOrEmpty(mountain.ImageUrl))
                {
                    <img src="@mountain.ImageUrl" class="card-img-top" alt="@mountain.Name" />
                }
                else
                {
                    <div class="hz-placeholder"><i class="bi bi-image-alt"></i></div>
                }
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">@mountain.Name</h4>
                    @if (mountain.HighestPeakName != null)
                    {
                        <div class="hz-meta mb-2">
                            <i class="bi bi-triangle-fill"></i> Най-висок: @mountain.HighestPeakName (@mountain.HighestPeakElevation м)
                        </div>
                    }
                    <p class="card-text small">@mountain.Description</p>
                    <div class="d-flex gap-3 hz-meta mb-3">
                        <span><i class="bi bi-house"></i> @mountain.HutsCount хижи</span>
                        <span><i class="bi bi-triangle"></i> @mountain.PeaksCount върха</span>
                        <span><i class="bi bi-signpost-split"></i> @mountain.TrailsCount маршрута</span>
                    </div>
                    <a asp-action="Details" asp-route-id="@mountain.Id" class="btn btn-hz mt-auto">Разгледай</a>
                </div>
            </div>
        </div>
    }
</div>