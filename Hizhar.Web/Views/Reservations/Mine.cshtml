@model IEnumerable<ReservationListItemViewModel>
@{
    ViewData["Title"] = "Моите резервации";
}

<div class="hz-page-header">
    <h1>Моите резервации</h1>
</div>

@if (!Model.Any())
{
    <div class="hz-panel text-center">
        <p class="mb-2">Все още нямате резервации.</p>
        <a asp-controller="Huts" asp-action="Index" class="btn btn-hz">Намери хижа</a>
    </div>
}
else
{
    <div class="hz-panel p-0 table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Хижа</th>
                    <th>Дати</th>
                    <th>Легла</th>
                    <th>Цена</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ReservationListItemViewModel reservation in Model)
                {
                    <tr>
                        <td><a asp-controller="Huts" asp-action="Details" asp-route-id="@reservation.HutId">@reservation.HutName</a></td>
                        <td>
                            @reservation.CheckIn.ToString("dd.MM.yyyy") – @reservation.CheckOut.ToString("dd.MM.yyyy")
                            <div class="small text-muted">@reservation.Nights нощ(и)</div>
                        </td>
                        <td>@reservation.Guests</td>
                        <td>@reservation.TotalPrice.ToString("0.00") лв.</td>
                        <td><span class="badge @reservation.StatusCssClass">@reservation.Status.GetDisplayName()</span></td>
                        <td class="text-end">
                            @if (reservation.CanCancel)
                            {
                                <form method="post" asp-action="Cancel" asp-route-id="@reservation.Id"
                                      data-confirm="Сигурни ли сте, че искате да анулирате резервацията?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Анулирай</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}