@{
    string? success = TempData[MessageConstants.SuccessMessageKey] as string;
    string? error = TempData[MessageConstants.ErrorMessageKey] as string;
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show auto-hide mt-3" role="alert">
        <i class="bi bi-check-circle"></i> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
    </div>
}