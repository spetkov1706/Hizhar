@model TrailConditionViewModel
<div class="hz-condition @Model.FreshnessCssClass">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <strong>@Model.ConditionType.GetDisplayName()</strong>
        <span class="when"><i class="bi bi-clock-history"></i> @Model.FreshnessText · @Model.ReportedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
    </div>
    <div>@Model.Description</div>
    <div class="when mt-1">
        <i class="bi bi-person"></i> @Model.AuthorName
        @if (ViewData["ShowTrail"] is true)
        {
            <span> · <a asp-area="" asp-controller="Trails" asp-action="Details" asp-route-id="@Model.TrailId">@Model.TrailName</a></span>
        }
    </div>
</div>