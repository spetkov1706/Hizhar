@model HutCardViewModel

<div class="card hz-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" />
    }
    else
    {
        <div class="hz-placeholder"><i class="bi bi-house-door"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title mb-1">@Model.Name</h5>
            <span class="badge bg-light text-dark">@Model.Altitude м</span>
        </div>
        <div class="hz-meta mb-2"><i class="bi bi-geo-alt"></i> @Model.MountainName</div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span>
                <partial name="_RatingStarsPartial" model="Model.AverageRating" />
                <small class="text-muted">(@Model.ReviewsCount)</small>
            </span>
            <partial name="_AmenitiesPartial" model="new AmenitiesViewModel(Model.HasWater, Model.HasElectricity, Model.HasFood)" />
        </div>

        <div class="hz-meta mb-3">
            <i class="bi bi-moon-stars"></i> @Model.BedsCount легла ·
            <i class="bi bi-cash-coin"></i> @Model.PricePerNight.ToString("0.00") лв./нощ
        </div>

        <a asp-area="" asp-controller="Huts" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-hz mt-auto">
            Виж хижата
        </a>
    </div>
</div>