@using Microsoft.AspNetCore.Identity
@inject SignInManager<Hizhar.Data.Models.ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        if (User.IsAdmin())
        {
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Админ
                </a>
            </li>
        }

        if (User.IsHutKeeper())
        {
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="HutKeeper" asp-action="Dashboard">
                    <i class="bi bi-house-gear"></i> Моята хижа
                    <vc:pending-reservations></vc:pending-reservations>
                </a>
            </li>
        }

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i> @User.Identity?.Name
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Моят профил</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Reservations" asp-action="Mine"><i class="bi bi-calendar-check"></i> Моите резервации</a></li>
                @if (!User.IsHutKeeper())
                {
                    <li><a class="dropdown-item" asp-area="" asp-controller="HutKeeper" asp-action="Apply"><i class="bi bi-key"></i> Стани хижар</a></li>
                }
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-gear"></i> Настройки на акаунта</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Изход</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sunset btn-sm ms-lg-2 mt-1" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>