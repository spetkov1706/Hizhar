@{
    ViewData["Title"] = "Грешка";
    int? statusCode = ViewData["StatusCode"] as int?;
}

<div class="text-center py-5">
    <i class="bi bi-cloud-lightning-rain display-1 text-secondary"></i>
    <h1 class="mt-3">Нещо се обърка</h1>
    @if (statusCode.HasValue)
    {
        <p class="lead">Код на грешката: @statusCode</p>
    }
    else
    {
        <p class="lead">Възникна неочаквана грешка. Опитайте отново след малко.</p>
    }

    @if (ViewData["RequestId"] is string requestId)
    {
        <p class="text-muted small">Request ID: <code>@requestId</code></p>
    }

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-hz mt-2">Към началната страница</a>
</div>