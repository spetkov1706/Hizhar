@model TrailCardViewModel

<div class="card hz-card">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h5 class="card-title mb-1">@Model.Name</h5>
            <partial name="_DifficultyBadgePartial" model="Model.Difficulty" />
        </div>
        <div class="hz-meta mb-2"><i class="bi bi-geo-alt"></i> @Model.MountainName · @Model.Season.GetDisplayName()</div>

        <div class="hz-meta mb-2">
            <i class="bi bi-flag"></i> @Model.StartPoint
            <i class="bi bi-arrow-right mx-1"></i>
            <i class="bi bi-flag-fill"></i> @Model.EndPoint
        </div>

        <div class="d-flex flex-wrap gap-3 hz-meta mb-3">
            <span><i class="bi bi-rulers"></i> @Model.LengthKm.ToString("0.#") км</span>
            <span><i class="bi bi-graph-up-arrow"></i> +@Model.ElevationGain м</span>
            <span><i class="bi bi-clock"></i> @Model.DurationText</span>
        </div>

        @if (Model.LatestConditionType.HasValue && Model.LatestConditionDate.HasValue)
        {
            <div class="small mb-3">
                <i class="bi bi-info-circle"></i>
                Последен доклад: <strong>@Model.LatestConditionType.Value.GetDisplayName()</strong>
                <span class="text-muted">(@Model.LatestConditionDate.Value.ToLocalTime().ToString("dd.MM.yyyy"))</span>
            </div>
        }

        <a asp-area="" asp-controller="Trails" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-hz mt-auto">
            Детайли за маршрута
        </a>
    </div>
</div>