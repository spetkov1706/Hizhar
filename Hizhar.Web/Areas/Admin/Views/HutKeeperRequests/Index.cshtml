@model IEnumerable<HutKeeperRequestViewModel>
@{
    ViewData["Title"] = "Заявки за хижари";
}

<h1 class="mb-3">Заявки за хижари</h1>

@if (!Model.Any())
{
    <div class="hz-panel text-muted">Няма подадени заявки.</div>
}
else
{
    <div class="hz-panel p-0 table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Потребител</th><th>Хижа</th><th>Съобщение</th><th>Дата</th><th>Статус</th><th class="text-end">Действия</th></tr>
            </thead>
            <tbody>
                @foreach (HutKeeperRequestViewModel request in Model)
                {
                    <tr>
                        <td>@request.UserEmail</td>
                        <td><a asp-area="" asp-controller="Huts" asp-action="Details" asp-route-id="@request.HutId">@request.HutName</a></td>
                        <td class="small" style="max-width: 320px">@request.Message</td>
                        <td class="small">@request.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>@request.Status.GetDisplayName()</td>
                        <td class="text-end text-nowrap">
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <form method="post" asp-action="Approve" asp-route-id="@request.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Одобри</button>
                                </form>
                                <form method="post" asp-action="Reject" asp-route-id="@request.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Отхвърли</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}