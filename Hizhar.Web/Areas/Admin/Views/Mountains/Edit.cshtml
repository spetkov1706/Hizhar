@model MountainFormModel
@{
    ViewData["Title"] = "Редакция на планина";
}

<h1 class="mb-3">Редакция: @Model.Name</h1>

<form method="post" class="hz-panel">
    <partial name="_MountainFormPartial" model="Model" />
    <button type="submit" class="btn btn-hz"><i class="bi bi-save"></i> Запази</button>
    <a asp-action="Index" class="btn btn-link">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}