@model TrailFormModel
@{
    ViewData["Title"] = "Нов маршрут";
}

<h1 class="mb-3">Нов маршрут</h1>

<form method="post" asp-action="Create" class="hz-panel">
    <partial name="_TrailFormPartial" model="Model" />
    <button type="submit" class="btn btn-hz mt-4"><i class="bi bi-plus-lg"></i> Създай</button>
    <a asp-action="Index" class="btn btn-link mt-4">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}