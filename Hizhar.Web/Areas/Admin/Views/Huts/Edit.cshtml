@model HutFormModel
@{
    ViewData["Title"] = "Редакция на хижа";
}

<h1 class="mb-3">Редакция: @Model.Name</h1>

@* Без asp-action – формата се изпраща на същия адрес (/Admin/Huts/Edit/5) *@
<form method="post" class="hz-panel">
    <partial name="_HutFormPartial" model="Model" />
    <button type="submit" class="btn btn-hz mt-4"><i class="bi bi-save"></i> Запази</button>
    <a asp-action="Index" class="btn btn-link mt-4">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}